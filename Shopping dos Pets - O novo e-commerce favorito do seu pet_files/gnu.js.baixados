CanopusEventCenter.addListener('ServerDataLoader.Loaded',function(data){$('.slideshow-item').slick({dots:!0,infinite:!0,speed:400,autoplay:!0,autoplaySpeed:5000,slidesToShow:1,slidesToScroll:1,});$('.slideshow-itemCategory').slick({dots:!0,infinite:!0,speed:400,autoplay:!0,autoplaySpeed:5000,slidesToShow:1,slidesToScroll:1,})})
$(document).on("click",".container-fluid.canopus-cart-container button.btn.btn-success.btn-block.btn-md.float-right",function(){dataLayer.push({'event':'iniciateCheckout'})});$(document).on("click","a#identification-identification-button-register",function(){$('input#data_de_nascimento-141').mask('00/00/0000');$('input#data_de_nascimento-141').attr("placeholder","DD/MM/YYYY")})